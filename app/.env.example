# Writ — the docket
#
# Copy to `.env.local`. Every value is NEXT_PUBLIC_ because the app has no privileged read:
# it makes exactly the calls your own browser could make, against exactly these endpoints.
# Nothing here is a secret, and there is nothing else to configure.

# ── where to read ────────────────────────────────────────────────────────────
# 16661 = 0G mainnet, 16602 = 0G Galileo testnet. Anything else needs the four
# addresses below set explicitly.
NEXT_PUBLIC_CHAIN_ID=16661

# Defaults to the chain's public RPC. Point it at a local anvil fork to work
# without spending anything:  anvil --fork-url https://evmrpc.0g.ai
NEXT_PUBLIC_RPC_URL=https://evmrpc.0g.ai

# ── the contracts ────────────────────────────────────────────────────────────
# Until these are set the app renders a stated gap rather than an empty page: it
# will tell a reader there is nothing to read, and why, instead of showing them
# something that looks like "no activity yet".
NEXT_PUBLIC_WRIT_REGISTRY=0x857D288652e4f4523347EFf1918B9E1263A574f4
NEXT_PUBLIC_POLICY_GATE_FACTORY=0x4320Ae51D672f2636a0faFfb2B28C5520013b6D7

# ── gates the factory did not deploy ─────────────────────────────────────────
# Comma-separated. A gate can be deployed by the factory, by a Foundry script,
# or by hand, and the factory's GateDeployed log only knows about the first
# kind. List any others here and the docket watches them the same way.
#
# The address below is the live AgentTreasury on mainnet: it went out through
# script/Deploy.s.sol, so without this line its settled approval and its settled
# refusal both render as records no gate ever acted on.
#
# An address here that does not answer as a gate is reported on the page with
# the reason. It is never quietly dropped, and never shown as a gate with no
# decisions.
NEXT_PUBLIC_GATES=0x2688059e106195941F320110bE2d5fe9a1c75fEE

# ── 0G's own infrastructure ──────────────────────────────────────────────────
# InferenceServing: the only authority on which key a provider's enclave signs
# with. Defaults to 0G's deployed address for the configured chain.
#   mainnet 0x47340d900bdFec2BD393c626E12ea0656F938d84
#   galileo 0xa79F4c8311FF93C06b8CfB403690cc987c93F91E
NEXT_PUBLIC_INFERENCE_SERVING=

# 0G Storage indexer. Answers GET /file?root=0x… with Access-Control-Allow-Origin: *,
# which is why "verify in your browser" is literally true — the page fetches the
# archived transcript itself and rebuilds its merkle root locally.
#   mainnet https://indexer-storage-turbo.0g.ai
#   galileo https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_STORAGE_INDEXER=

# Block explorer for the outbound links. Leave blank and the app prints the
# hashes as plain text rather than linking somewhere that may not exist.
NEXT_PUBLIC_EXPLORER=https://chainscan.0g.ai

# ── how far back to look ─────────────────────────────────────────────────────
# The registry's deployment block. Set this. Public RPCs cap the span of one
# eth_getLogs call, so the docket walks the range in chunks, and 0G mainnet is
# past 42 million blocks — starting from genesis means a reviewer waits for
# thousands of chunked calls before the first row appears. Left at 0 the app
# scans the last 120,000 blocks instead, which is fast but will miss anything
# older. Either way the page states the exact range it read.
NEXT_PUBLIC_FROM_BLOCK=42839181
