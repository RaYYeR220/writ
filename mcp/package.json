{
  "name": "@writ/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets any AI agent produce and settle its own TEE-attested decisions on 0G.",
  "bin": {
    "writ-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "pnpm --dir ../sdk build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "0.9.0",
    "@0gfoundation/0g-storage-ts-sdk": "1.2.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@writ/sdk": "link:../sdk",
    "ethers": "6.13.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
