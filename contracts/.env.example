# Configuration for script/Deploy.s.sol. Copy to .env and fill in.
#
# Dry run first — it reads the chain, deploys nothing and costs nothing:
#   forge script script/Deploy.s.sol --fork-url https://evmrpc.0g.ai
#
# Then, with a funded deployer:
#   forge script script/Deploy.s.sol --rpc-url https://evmrpc.0g.ai --broadcast
#
# 0G mainnet is chain id 16661, RPC https://evmrpc.0g.ai.

# 0G's official InferenceServing contract. Every check the registry makes is read live from
# here, and the address is immutable once WritRegistry is deployed, so get it right.
#   mainnet          0x47340d900bdFec2BD393c626E12ea0656F938d84  (chain 16661)
#   Galileo testnet  0xa79F4c8311FF93C06b8CfB403690cc987c93F91E  (chain 16602)
INFERENCE_SERVING=0x47340d900bdFec2BD393c626E12ea0656F938d84

# The 0G Compute provider the deployed gate will accept proofs from. It MUST be an acknowledged
# TeeML service; the script reads the provider before broadcasting and aborts if it is not,
# because a gate pointed at a provider that cannot produce verifiable proofs is bricked from
# birth. The gate's model is taken from whatever this provider reports serving, not from here.
#
# Leading mainnet candidate, serving 0GM-1.0-35B-A3B:
TEE_PROVIDER=0x4870CbC4D07d6Ac2EE5aA865588e5985FE77a4E9

# The only address allowed to call execute() on the deployed AgentTreasury. This is the agent.
AGENT_ADDRESS=

# Holds the treasury's timelocked recovery hatch. Deliberately NOT the agent: the agent must
# never be able to take an escape hatch it can also open by simply not asking for verdicts.
OWNER_ADDRESS=

# Risk ceiling, 0-100. An ALLOW scoring above this is refused by the policy even though the
# model was willing. 100 would wave through every verdict the grammar can express.
MAX_RISK=50

# Deployer key. Pays for the three deployments and nothing else — it holds no authority over
# any deployed contract afterwards. Keep .env out of git.
DEPLOYER_PRIVATE_KEY=
